# Copy to VPS secret path (never commit filled file).
# Example: /etc/karzar/gsc-mcp.env
#   sudo install -o YOUR_DEPLOY_USER -g YOUR_DEPLOY_USER -m 600 .env.gsc-mcp /etc/karzar/gsc-mcp.env
#
# Used with:
#   docker compose -f docker-compose.gsc-mcp.yml --env-file /etc/karzar/gsc-mcp.env up -d --build gsc_mcp

GOOGLE_GSC_CLIENT_ID=replace-me-google-oauth-client-id
GOOGLE_GSC_CLIENT_SECRET=replace-me-google-oauth-client-secret
GOOGLE_GSC_REFRESH_TOKEN=replace-me-google-refresh-token

# High-entropy MCP client secret, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
KARZAR_MCP_ACCESS_TOKEN=replace-me-mcp-bearer-token

# Optional — Chrome UX Report API key (restricted to CrUX API only)
# CRUX_API_KEY=
