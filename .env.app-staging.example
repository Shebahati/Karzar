# Isolated application-staging environment template (250B primitives only).
# Copy to `.env.app-staging` and fill secrets. NEVER commit real secrets.
#
# Compose project: `docker-compose.app-staging.yml`
# NOT provisioned on the live VPS in 250B — declarative template only.
#
# Future hosts (NOT provisioned in 250B):
#   www.staging.karzartools.com
#   api.staging.karzartools.com
#   admin.staging.karzartools.com

APP_ENV=staging
KARZAR_DATA_PLANE=staging
KARZAR_MEDIA_PLANE=staging
KARZAR_APP_STAGING_DB_NAME=karzar_app_staging

DEBUG=False
ENABLE_API_DOCS=False
OTP_DEV_ECHO=False
ENABLE_METRICS=False
ENFORCE_HTTPS=False
LOG_TO_FILE=True
LOG_FILE=/app/logs/app.log
MAX_REQUEST_BODY_BYTES=1048576

TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXIES=127.0.0.1
PUBLIC_ASSET_BASE=http://127.0.0.1:8020

POSTGRES_USER=karzar_app_staging
POSTGRES_PASSWORD=replace-with-strong-app-staging-password
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=karzar_app_staging

REDIS_HOST=redis
REDIS_PORT=6379

SECRET_KEY=replace-with-a-random-secret-key-at-least-32-chars
ADMIN_STEP_UP_PIN=replace-with-strong-pin
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

PURCHASE_CHECKOUT_ENABLED=false
PAYMENT_PROVIDER=mock
SMS_PROVIDER=console

HESABFA_ENABLED=false
POSTEX_ENABLED=false
POSTEX_BOOKING_ENABLED=false
DISABLE_BACKGROUND_WORKERS=1
