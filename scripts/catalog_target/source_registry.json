{
  "version": "3",
  "source_root_env": "KARZAR_TARGET_SOURCE_DIR",
  "notes": "Explicit per-file authority. Relative paths are under KARZAR_TARGET_SOURCE_DIR. Filename matching uses folder identity; brand need not appear in the filename. Duplicate tree اد محصول 15 شهریور is not a second universe. AST family membership is not conferred by arbitrary PDFs.",
  "duplicate_trees": ["اد محصول 15 شهریور"],
  "sku_headers": ["sku", "SKU", "CODE", "code", "product_code", "کد", "کد کالا"],
  "brand_headers": ["brand", "Brand", "برند"],
  "price_headers": ["price", "base_price", "قیمت", "stored_price", "قیمت دلاری", "TOMAN", "toman"],
  "currency_headers": ["currency", "price_currency", "واحد"],
  "status_headers": ["status", "وضعیت", "inventory_status"],
  "family_headers": ["product_family", "family", "خانواده"],
  "insize": {
    "never_use_distributor_as_universe": true,
    "match": "exact_normalized_sku",
    "status_available_values": ["موجود"],
    "sku_headers": ["CODE", "SKU", "product_code", "کد", "کد کالا"],
    "unique_sku_sanity_low": 800,
    "unique_sku_sanity_high": 950
  },
    "ast_enumerators": {
      "product_scope_price_filename_contains": [
        "لیست قیمت",
        "لیست همکاری",
        "فهرست قیمت",
        "فهرست همکاری",
        "price list",
        "همکاری"
      ],
      "catalog_filename_contains": [
        "کاتالوگ",
        "بروشور",
        "catalogue",
        "catalog",
        "brochure"
      ]
    },
  "sources": [
    {
      "id": "insize.product_list",
      "brand": "INSIZE",
      "product_family": "measurement",
      "roles": ["product_scope"],
      "parser": "pdf_sku",
      "sku_kind": "insize",
      "membership_authority": "required",
      "match": {
        "parent_folder": "اینسایز",
        "ancestor_folder": "اندازه گیری",
        "filename_equals": ["لیست محصولات.pdf"]
      }
    },
    {
      "id": "insize.distributor",
      "brand": "INSIZE",
      "product_family": "measurement",
      "roles": ["price", "inventory"],
      "never_product_scope": true,
      "parser": "insize_distributor_xlsx",
      "membership_authority": "not_membership",
      "authority_reason": "price_inventory_only",
      "match": {
        "parent_folder": "اینسایز",
        "ancestor_folder": "اندازه گیری",
        "filename_contains": ["موجودی توزیع کننده"]
      }
    },
    {
      "id": "insize.catalog",
      "brand": "INSIZE",
      "product_family": "measurement",
      "roles": ["catalog"],
      "parser": "none",
      "match": {
        "parent_folder": "اینسایز",
        "filename_contains": ["کاتالوگ"]
      }
    },
    {
      "id": "terma.price_list",
      "brand": "TERMA",
      "product_family": "measurement",
      "roles": ["product_scope", "price"],
      "parser": "pdf_sku_price",
      "sku_kind": "terma",
      "source_currency": "rial",
      "markup_already_present": true,
      "membership_authority": "required",
      "match": {
        "parent_folder": "ترما",
        "filename_contains": ["لیست قیمت ترما"]
      }
    },
    {
      "id": "terma.catalog",
      "brand": "TERMA",
      "product_family": "measurement",
      "roles": ["catalog"],
      "parser": "none",
      "match": {
        "parent_folder": "ترما",
        "filename_contains": ["کاتالوگ ترما"]
      }
    },
    {
      "id": "dasqua.price_list",
      "brand": "DASQUA",
      "product_family": "measurement",
      "roles": ["product_scope", "price"],
      "parser": "pdf_sku_price",
      "sku_kind": "dasqua",
      "source_currency": "rial",
      "markup_already_present": true,
      "membership_authority": "required",
      "match": {
        "parent_folder": "داسکوا",
        "filename_contains": ["لیست قیمت داسکوا"]
      }
    },
    {
      "id": "dasqua.catalog",
      "brand": "DASQUA",
      "product_family": "measurement",
      "roles": ["catalog"],
      "parser": "none",
      "match": {
        "parent_folder": "داسکوا",
        "filename_contains": ["کاتالوگ داسکوا"]
      }
    },
    {
      "id": "guanglu.price_list",
      "brand": "GUANGLU",
      "product_family": "measurement",
      "roles": ["price"],
      "never_product_scope": true,
      "parser": "pdf_sku_price",
      "sku_kind": "guanglu",
      "source_currency": "rial",
      "membership_authority": "deferred",
      "authority_reason": "commercial_price_list_without_stable_manufacturer_identity_requires_future_manual_mapping_or_new_authoritative_source",
      "wave": "1_deferred",
      "match": {
        "parent_folder": "گوانگلو(GL)",
        "filename_contains": ["لیست قیمت گوانگلو"]
      }
    },
    {
      "id": "mitutoyo.catalog",
      "brand": "MITUTOYO",
      "product_family": "measurement",
      "roles": ["catalog"],
      "parser": "none",
      "membership_authority": "not_membership",
      "authority_reason": "catalog_specification_only",
      "match": {
        "parent_folder": "میتوتویو",
        "filename_contains": ["کاتالوگ میتوتویو"]
      }
    },
    {
      "id": "dcoil.price_list",
      "brand": "DCOIL",
      "product_family": "helicoil",
      "roles": ["product_scope", "price"],
      "parser": "pdf_sku_price",
      "sku_kind": "dcoil",
      "source_currency": "rial",
      "markup_already_present": true,
      "membership_authority": "required",
      "match": {
        "parent_folder": "DCOIL",
        "filename_contains": ["لیست قیمت DCOIL"]
      }
    },
    {
      "id": "shams.catalog",
      "brand": "SHAMS",
      "product_family": "helicoil",
      "roles": ["catalog", "media"],
      "parser": "pdf_or_media",
      "membership_authority": "not_membership",
      "authority_reason": "catalog_media_only_no_product_list",
      "match": {
        "parent_folder": "شمس"
      }
    }
  ],
  "ast_families": [
    {"id": "ast.chuck", "product_family": "chuck", "folder_names": ["سه نظام", "AST powerسه نظام"]},
    {"id": "ast.tapping_collets", "product_family": "tapping_collets", "folder_names": ["قلاویزگیر", "قلاویزگیر AST  کلت و دنبالهPower"]},
    {"id": "ast.tool_grinder", "product_family": "tool_grinder", "folder_names": ["ابزارتیزکن", "ابزار تیزکن"]},
    {"id": "ast.tailstock", "product_family": "tailstock", "folder_names": ["تایکوپ", "تایکوپ و صفحه گردان"]},
    {"id": "ast.rotary_table", "product_family": "rotary_table", "folder_names": ["صفحه گردان"]},
    {"id": "ast.magnetic_drill", "product_family": "magnetic_drill", "folder_names": ["دریل مگنت", "دریل مگنت و کرگیری"]},
    {"id": "ast.core_drill", "product_family": "core_drill", "folder_names": ["کرگیری"]},
    {"id": "ast.et_taps", "product_family": "et_taps", "folder_names": ["قلاویز ET"]},
    {"id": "ast.pneumatic_tapping", "product_family": "pneumatic_tapping", "folder_names": ["قلاویززن بادی", "قلاویز زن بادی"]},
    {"id": "ast.cutting_fluid", "product_family": "cutting_fluid", "folder_names": ["روغن آب صابون"]},
    {"id": "ast.automatic_tapping", "product_family": "automatic_tapping", "folder_names": ["قلاویززن اتومات", "قلاویز زن اتومات"]},
    {"id": "ast.electric_tapping", "product_family": "electric_tapping", "folder_names": ["قلاویززن برقی", "قلاویز زن برقی"]},
    {"id": "ast.multi_spindle", "product_family": "multi_spindle", "folder_names": ["مولتی اسپیندل"]},
    {"id": "ast.hole_saws", "product_family": "magnetic_drill_hole_saws", "folder_names": ["گردبر دریل مگنت"]},
    {"id": "ast.utex", "product_family": "utex_drills", "folder_names": ["مته یوتکس"]},
    {"id": "ast.spade", "product_family": "spade_drills", "folder_names": ["مته برگی"]}
  ],
  "ast_roots": ["آذرصنعت/AST Power", "آذرصنعت/ASTPOWER", "آذرصنعت"]
}
