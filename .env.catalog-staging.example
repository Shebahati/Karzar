# Isolated catalog-staging environment template.
# Copy to `.env.catalog-staging` and fill secrets. NEVER commit real secrets.
#
# This file is for the SEPARATE Compose project in
# `docker-compose.catalog-staging.yml` — not for the live VPS stack
# (`docker-compose.yml` + `docker-compose.staging.yml`).
#
# See docs/CATALOG_STAGING_ISOLATION.md.

APP_ENV=staging
KARZAR_DATA_PLANE=catalog_staging
KARZAR_MEDIA_PLANE=catalog_staging
KARZAR_CATALOG_STAGING_DB_NAME=karzar_catalog_staging

DEBUG=False
ENABLE_API_DOCS=True
OTP_DEV_ECHO=False
ENABLE_METRICS=True
# Loopback rehearsal default; set true only behind real TLS termination.
ENFORCE_HTTPS=False
LOG_TO_FILE=True
LOG_FILE=/app/logs/app.log
MAX_REQUEST_BODY_BYTES=1048576

# Hostname is configurable — do NOT assume or register DNS in this PR.
# Example loopback / private host for local isolation proof:
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXIES=127.0.0.1
PUBLIC_ASSET_BASE=http://127.0.0.1:8010

# Database — MUST differ from live (`karzar_staging` on the public VPS).
POSTGRES_USER=karzar_catalog_staging
POSTGRES_PASSWORD=replace-with-strong-catalog-staging-password
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=karzar_catalog_staging

REDIS_HOST=redis
REDIS_PORT=6379

SECRET_KEY=replace-with-a-random-secret-key-at-least-32-chars
ADMIN_STEP_UP_PIN=replace-with-strong-pin
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

SMS_PROVIDER=console
PURCHASE_CHECKOUT_ENABLED=false
PAYMENT_PROVIDER=mock
PAYMENT_CALLBACK_URL=http://127.0.0.1:3000/checkout/payment/callback
PAYMENT_SUCCESS_REDIRECT_URL=http://127.0.0.1:3000/checkout/success
PAYMENT_FAILURE_REDIRECT_URL=http://127.0.0.1:3000/checkout/payment/failed

# Keep external commerce integrations OFF for catalog rehearsal.
HESABFA_ENABLED=false
HESABFA_TEST_MODE=true
HESABFA_ADMIN_READS_ENABLED=false
POSTEX_ENABLED=false

INITIAL_SUPER_ADMIN_PHONE=
INITIAL_SUPER_ADMIN_PASSWORD=
INITIAL_SUPER_ADMIN_NAME=Catalog Staging Admin

APP_SERVER=gunicorn
GUNICORN_WORKERS=1

# Host publish ports (compose interpolation)
CATALOG_STAGING_API_PORT=8010
CATALOG_STAGING_DB_PORT=5436
CATALOG_STAGING_REDIS_PORT=6380
